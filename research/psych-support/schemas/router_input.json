{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "router_input",
  "type": "object",
  "properties": {
    "current_user_message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "const": "user"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "available_prior_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "role",
          "content"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "consented_user_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "consented": {
            "const": true
          },
          "provided_at_message_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "text",
          "consented",
          "provided_at_message_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "previous_action": {
      "enum": [
        "none",
        "reflect",
        "paraphrase",
        "clarify",
        "affirm",
        "suggest",
        "inform",
        "repair_misunderstanding",
        "close",
        "safety_protocol"
      ]
    },
    "safety_signal": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "high",
            "clear_for_general_support"
          ]
        },
        "origin": {
          "enum": [
            "external_fixture",
            "independent_safety_interface"
          ]
        },
        "evidence_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 1000
        }
      },
      "required": [
        "status",
        "origin",
        "evidence_message_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "current_user_message",
    "available_prior_messages",
    "consented_user_context",
    "previous_action",
    "safety_signal"
  ],
  "additionalProperties": false
}
